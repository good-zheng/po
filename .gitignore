# Dependencies
node_modules/
.pnpm-store/
package-lock.json

# Build output
apps/*/dist/
# Umi 把临时产物生成在 src/.umi*/ 下（不是 app 根），所以必须用不带路径前缀的模式匹配任意层级；
# 写成 apps/*/.umi*/ 会漏掉 novel-web 那 68 个文件，其中 appData.json 还带本机局域网 IP。
.umi/
.umi-production/
packages/*/dist/
services/api/**/target/
services/chat/.pytest_cache/
.pytest_cache/
services/chat/**/__pycache__/
# 编译缓存全局忽略：tools 下的 Python 缓存和 Taro 的 .swc 之前会漏进 git status
__pycache__/
.swc/
*.tsbuildinfo
services/chat/*.egg-info/
services/agent-core/.venv/
services/agent-core/.pytest_cache/
services/agent-core/**/__pycache__/
services/agent-core/build/
services/agent-cooking/.venv/
services/agent-cooking/.pytest_cache/
services/agent-cooking/**/__pycache__/
*.egg-info/
.agent-core/

# Runtime state and secrets
.env
.env.*
!.env.example
# 前端两个站点（novel-web / admin-web）的生产域名档必须入库（镜像构建时要读，值烘进 JS 产物），
# 本机开发档 .env.local 仍不入库
!apps/novel-web/.env
!apps/admin-web/.env
services/api/src/main/resources/application-local.yaml
services/api/api-bootstrap/src/main/resources/application-local.yaml
# 生产密钥不入库：profile 文件与备忘 json 一律忽略
services/api/api-bootstrap/src/main/resources/application-prod.yaml
services/api/application-prod.json
services/chat/deploy-prod.json
services/api/api-bootstrap/uploads/
services/api/uploads/
services/chat/.venv/
services/chat/agent_*.json
# Google OAuth 控制台下载的 client_secret_*.json（曾落在 apps/cooking-mini/）
client_secret_*.json
**/logs/
# 自动生成的仓库知识卡：含内网服务地址与私有模块结构，只留本机。
# 规则出处见 scripts/WIKI_SYNC.md（repowiki 与 auto-memory 一律不上站）。
.qoder/repowiki/

# Scratch and generated asset sources
vibe_images/
.tmp/
# 本地项目记忆（含内部标识与未发布决策），与 repowiki 同级，一律不上公开仓库
.workbuddy/
/covers-list.tsv
/ingredients-count.txt
/ingredients-image-list.tsv

# 第三方项目的本地副本：PowerWiki 是解压进来的上游代码（含 node_modules 107M、自带 .env），
# 不入库。需要时从上游仓库单独 clone。
apps/power-wiki/

# Tooling and OS files
.DS_Store
.idea/
.vscode/
*.log
coverage/
.wrangler/
