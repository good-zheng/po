{
  "name": "@po/echo-talk",
  "version": "0.1.0",
  "private": true,
  "description": "言外是帮你听懂弦外之音的沟通助手：录下对方的话，实时转写成字，告诉你他真正想说什么，并给出可以直接照着说的回复",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@po/types": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.1",
    "babel-preset-taro": "4.2.1",
    "css-loader": "^6.10.0",
    "sass": "^1.71.0",
    "style-loader": "^3.3.4",
    "typescript": "^5.4.0",
    "webpack": "~5.95.0"
  }
}
