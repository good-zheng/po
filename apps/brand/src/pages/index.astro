---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import Projects from '~/components/widgets/Projects.astro';
import Content from '~/components/widgets/Content.astro';
import Image from '~/components/common/Image.astro';
import Bento from '~/components/widgets/Bento.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features from '~/components/widgets/Features.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { LIVE } from '~/links';

const metadata = {
  title: '叮叮厨 — 菜谱平台与 AI 做菜助手',
  description:
    '叮叮厨：菜谱内容平台 + AI 做菜助手。微信小程序、Expo App、管理后台三端，Java 与 Python 双后端，一套跨端契约，部署在微信云托管。同一条底座上还长出了言外 EchoTalk 与言外书斋。',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="独立开发 · 全栈作品"
    badge="进行中"
    image={{
      src: '~/assets/images/hero.svg',
      alt: '插画：手机立在厨房台面上，屏幕里是分步的做菜界面、计时环与声波，旁边飘着 AI 语音气泡和食材清单',
      format: 'svg',
    }}
    actions={[
      { variant: 'primary', text: '看作品', href: '#products', icon: 'tabler:chef-hat' },
      { text: '言外 EchoTalk', href: '/yanwai' },
      { text: '言外书斋', href: '/novel' },
    ]}
  >
    <Fragment slot="title">
      叮叮厨：<span class="text-accent dark:text-white">会说话</span>的菜谱与 AI 做菜助手
    </Fragment>

    <Fragment slot="subtitle">
      一份菜谱从被读到被做出来，中间隔着火候、克数和腾不出手的那几分钟。叮叮厨把这一段交给语音和
      AI：步骤一句句读给你听，计时结束敲一下铃，随时能问一句「现在该干什么」。
    </Fragment>

    <Fragment slot="content">
      <p class="max-w-2xl mx-auto mt-6 text-sm text-muted">
        三端客户端、两个后端服务、一条 AI 链路，全部由我一个人设计与实现，跑在微信云托管上。
        同一条底座上还长出了第二件作品（言外 EchoTalk）与第三件（言外书斋）。
      </p>
    </Fragment>
  </Hero>

  <!-- SocialProof Widget ************ -->

  <SocialProof
    id="proof"
    classes={{ container: '!pb-14 md:!pb-20' }}
    items={[
      { value: '3', label: '端：小程序 / App / 管理后台', icon: 'tabler:devices', color: 'text-orange-500' },
      { value: '146', label: '自动化测试用例', icon: 'tabler:test-pipe', color: 'text-emerald-500' },
      { value: '4', label: '层 AI 降级路径', icon: 'tabler:layers-intersect', color: 'text-sky-500' },
      { value: '0', label: '个入库密钥', icon: 'tabler:key-off', color: 'text-rose-500' },
    ]}
  />

  <!-- Note Widget ******************* -->

  <Note
    variant="info"
    title="说明"
    description="这是项目与个人的介绍站，不是线上产品官网。带手机外框的两屏是真机截图，架构与流程图仍是示意插画；对外公开访问地址在配置完域名之后开放。"
  />

  <!-- Products Widget *************** -->

  <Projects
    id="products"
    tagline="作品"
    title="三件作品，一套底座"
    subtitle="第一个把多端与 AI 链路走通，第二个坐在同一套底座上再走一遍，第三个把这套底座逼向了它原本没打算撑的东西：长文本的一致性。"
    columns={2}
    items={[
      {
        title: '叮叮厨 · 会说话的菜谱与 AI 做菜助手',
        description:
          '菜谱内容平台加做菜全程语音。三端客户端、Java 与 Python 双后端、一条四层降级的 AI 链路；手上沾着油时，它替你读步骤、盯计时、答问题。',
        tags: ['Taro', 'Expo', 'Spring Boot', 'FastAPI', 'LangGraph'],
        image: {
          src: '~/assets/images/hero.svg',
          alt: '插画：手机立在厨房台面上，屏幕里是分步的做菜界面与计时环',
          format: 'svg',
        },
        href: '#projects',
        linkText: '看它的构成',
      },
      {
        title: '言外 EchoTalk · 听懂弦外之音的实时沟通助手',
        description:
          '录下对方的话，实时转写成字，再给出意图、潜台词、情绪、风险与三句可照读的回复。从声音进来，到话术出去，是一条不断头的链路。',
        tags: ['实时 ASR', '垂直 Agent', '结构化输出', '隐私前置'],
        image: {
          src: '~/assets/images/projects/echo-talk.svg',
          alt: '插画：手机里是转写气泡与洞察卡，右侧分出三张回复卡，左侧有一串声波',
          format: 'svg',
        },
        href: '/yanwai',
        linkText: '看这个产品',
      },
      {
        title: '言外书斋 · 让第 27 章还记得第 3 章',
        description:
          '反幻觉的长篇小说链路：设定不再是提示词里的一段描述，而是数据库里带出处、带生效区间的正典断言；单章注入预算恒定，计划与正文各过一道闸门，只有过了闸门的抽取才写得回记忆。',
        tags: ['LangGraph', 'FastAPI', 'Spring Boot', 'MySQL', '人在环'],
        image: {
          src: '~/assets/images/projects/novel-agent.svg',
          alt: '插画：左侧是一章正文，中间是规则与裁判两道闸门，右侧是带出处的正典断言台账，一条虚线把未通过的稿子退回重写',
          format: 'svg',
        },
        href: LIVE.novel,
        linkText: '打开阅读端',
        result: '305 个测试用例；实测三章过正文闸门入库，计划闸门每章都要作者拍板',
      },
    ]}
  />

  <!-- Projects Widget *************** -->

  <Projects
    id="projects"
    tagline="叮叮厨的构成"
    title="六个部分，一条链路"
    subtitle="从用户手指点下去的那一下，到服务器把音频合成好返回来，中间每一段都是自己写的。"
    columns={2}
    items={[
      {
        title: '微信小程序（面向用户的主入口）',
        description:
          'Taro 4.2.1 + React。首页与菜谱对游客完全开放，只有「开始做菜」和「发送消息」这两个动作才要求登录；AI 指导走 WebSocket 流式，进做菜页就预取全部步骤音频。',
        tags: ['Taro', 'React', 'WebSocket', '按需注入'],
        image: {
          src: '~/assets/images/projects/mini-program.svg',
          alt: '插画：小程序菜谱列表与一个带厨师帽的语音气泡',
          format: 'svg',
        },
      },
      {
        title: '移动端 App',
        description:
          'Expo SDK 57 + expo-router + NativeWind。与小程序逐屏对齐：菜谱详情的份数换算、做菜模式的铃声与震动、收起的计时器、完成播报，两端行为一致。',
        tags: ['Expo', 'React Native', 'NativeWind'],
        image: {
          src: '~/assets/images/projects/mobile-app.svg',
          alt: '插画：手机与平板显示同一屏做菜界面，中间是同步箭头',
          format: 'svg',
        },
      },
      {
        title: '业务后端 API',
        description:
          'Java 17 + Spring Boot 4.1.1，Maven reactor 拆成 shared / identity / recipe / api-bootstrap。MyBatis-Plus 做持久层，表结构以 schema.sql 为准；讯飞 TTS 与腾讯云 COS 都在这侧。',
        tags: ['Spring Boot', 'MyBatis-Plus', 'MySQL', 'JWT'],
        image: {
          src: '~/assets/images/projects/backend-api.svg',
          alt: '插画：分层的后端服务与数据库，右侧是一个统一响应信封',
          format: 'svg',
        },
        result: '统一 Result&lt;T&gt; 信封，三端共用一套解包',
      },
      {
        title: 'AI 聊天服务',
        description:
          'FastAPI + LangGraph。Orchestrator 下挂烹饪 VerticalAgent，意图路由用 dense embedding + BM25 混合检索；语言模型走 DeepSeek，向量走阿里云百炼。对外只有一个 /ws/chat。',
        tags: ['FastAPI', 'LangGraph', 'DeepSeek'],
        image: {
          src: '~/assets/images/projects/ai-service.svg',
          alt: '插画：编排节点分发给多个垂直 Agent，含向量检索与流式回答气泡',
          format: 'svg',
        },
      },
      {
        title: '管理后台',
        description:
          'Umi Max 4 + React 19 + Ant Design 6。菜谱与分类维护、封面上传、用户注册审批流；表单和列表都直接吃同一份跨端类型。小说创作工作台也在这里。',
        tags: ['Ant Design Pro', 'React Query', 'Biome'],
        image: {
          src: '~/assets/images/projects/admin-console.svg',
          alt: '插画：管理后台的列表与表单，右侧是封面上传和审批通过标记',
          format: 'svg',
        },
        href: LIVE.admin,
        linkText: '打开管理后台',
      },
      {
        title: '契约与工程化',
        description:
          'pnpm workspace monorepo。packages/types 是三端字段的唯一来源；根目录一组 pnpm 脚本屏蔽 Windows 与镜像源差异；部署留下台账，不靠记忆里的地址。',
        tags: ['pnpm workspace', '@po/types', 'CloudRun'],
        image: {
          src: '~/assets/images/projects/contracts.svg',
          alt: '插画：一份类型契约连向小程序、App 与后台，下方是 monorepo 目录树',
          format: 'svg',
        },
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="screens"
    tagline="真机截图"
    title="小程序里实际跑着的是这两屏"
    subtitle="左边是每个人都能逛的首页，是一段真机录屏，点开即播；右边是只有开口才要登录的 AI 助手。两屏都来自真机，不是设计稿。"
    content={`<ul class="space-y-5 text-base text-muted">
      <li><strong class="text-heading">首页 · 菜谱流对游客完全开放</strong> — 搜索、推荐 / 最多点赞 / 最新发布三种排序，难度与分类两组筛选，双列菜谱卡带难度、耗时与点赞数。封面走对象存储，链接进数据库，端上只管渲染。左边那一屏是真机录屏，点开就能看滚动时的吸顶筛选栏。</li>
      <li><strong class="text-heading">AI 助手 · 会推荐也会讲为什么</strong> — 一句「推荐几道快手菜」，回来的不是菜谱列表，是三道带耗时与难度的选择、每道一句做法要点，末尾还能横滑直接跳进对应菜谱。回答沿 WebSocket 逐字流出，不是转圈等整段。</li>
      <li><strong class="text-heading">两屏之间只隔一次登录</strong> — 逛菜谱不要账号；只有按下「开始做菜」和真正按下发送那一刻才要，且从不把你硬推进登录页，页面上留的是提示和一个「去登录」。</li>
    </ul>`}
  >
    <Fragment slot="image">
      <div class="mx-auto grid max-w-[560px] grid-cols-2 gap-4 md:gap-6">
        <video
          class="w-full rounded-[26px] bg-white shadow-xl ring-1 ring-slate-900/10 dark:ring-white/10"
          src="/demo/dingdingchu-home-scroll.mp4"
          poster="/demo/dingdingchu-home-poster.webp"
          width="552"
          height="1192"
          controls
          playsinline
          preload="none"
          aria-label="真机录屏：叮叮厨小程序首页向下滚动，筛选栏吸顶，双列菜谱卡的封面依次进入视野"></video>
        <Image
          src="~/assets/images/screenshots/dingdingchu-ai-chat.png"
          width={549}
          height={1192}
          widths={[220, 320, 440]}
          sizes="(max-width: 767px) 44vw, 260px"
          format="webp"
          layout="constrained"
          class="w-full rounded-[26px] shadow-xl ring-1 ring-slate-900/10 dark:ring-white/10"
          alt="真机截图：叮叮厨小程序 AI 助手页，用户问「推荐几道快手菜」，助手回答里列出辣椒炒肉、长沙凉面、蒜薹炒腊肉三道并各附做法要点，下方是可横滑的菜谱跳转卡"
        />
      </div>
    </Fragment>
  </Content>

  <!-- Bento Widget ****************** -->

  <Bento
    id="architecture"
    tagline="架构"
    title="一次请求走过的路"
    subtitle="端不直接请求 AI，AI 也不直接碰数据库；两边各司其职，中间靠契约缝合。"
    columns={3}
    items={[
      {
        title: '客户端只认一个信封',
        description: '所有 HTTP 响应都是 Result&lt;T&gt;，分页统一 Page 语义。换后端框架不用改编。',
        icon: 'tabler:package',
      },
      {
        title: 'HTTP 与 WebSocket 分家',
        description: '读数据走 Java 的 /api，聊天走 Python 的 /ws/chat。两条协议各用各的连接方式，互不拖累。',
        icon: 'tabler:arrows-split-2',
        span: 2,
      },
      {
        title: '语音只返回 URL',
        description: '后端把合成好的音频放进对象存储，接口回一个公网 URL；小程序进页面即批量预热。',
        icon: 'tabler:volume',
      },
      {
        title: '会话状态可插拔',
        description: 'Agent 的检查点优先落 Redis Stack，不可用则退内存，功能不受影响，只是记不住上下文。',
        icon: 'tabler:database',
      },
      {
        title: '密钥永远不进仓库',
        description: '模型、对象存储、云托管的凭据一律只在各自 .env；文档与代码里不出现任何真实值。',
        icon: 'tabler:shield-lock',
      },
    ]}
  />

  <!-- QuickStart Widget ************* -->

  <QuickStart
    id="quick-start"
    tagline="跑起来"
    title="本地起这套东西要几步"
    subtitle="不是营销话术，这里是仓库里真实存在的脚本。"
    commands={[
      { command: 'pnpm install', comment: '装工作区依赖（Node ≥ 22）' },
      { command: 'docker compose up -d mysql redis', comment: '先起基础设施' },
      { command: 'pnpm types:build', comment: '先出跨端契约' },
      { command: 'pnpm api:start', comment: 'Java 业务后端 :8080' },
      { command: 'pnpm chat:start', comment: 'AI 聊天服务 :5090' },
      { command: 'pnpm mini:dev', comment: '微信小程序，用开发者工具打开 dist/' },
    ]}
    items={[
      {
        title: '一个仓库，三种语言生态',
        description:
          'TypeScript / Java / Python 各管各的构建，但都从同一个根 <code>package.json</code> 的脚本入口出发，不用记目录。',
        icon: 'tabler:git-branch',
      },
      {
        title: '验证比写代码更认真',
        description:
          '<code>pnpm api:verify</code>、<code>chat:test</code>、<code>admin:test</code>、<code>mini:build</code> 全绿才算改完。改契约字段先看类型包报不报错。',
        icon: 'tabler:circle-check',
      },
      {
        title: '菜谱语料当工程件管',
        description:
          '<code>seed/*.json</code> 是唯一真源，导入用的 <code>data-*.sql</code> 全部由脚本生成，批次清单集中在一个文件里。生成侧 296 道，重跑一条命令。',
        icon: 'tabler:database-import',
      },
    ]}
  >
    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(251_146_60/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.18),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(234_88_12/0.22),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.14),transparent_65%)]"
      >
      </div>
    </Fragment>
  </QuickStart>

  <!-- Features Widget *************** -->

  <Features
    id="decisions"
    tagline="关键决策"
    title="真正难的部分是取舍"
    subtitle="功能列表谁都会写。下面这几条是踩过之后才会做的决定。"
    columns={2}
    items={[
      {
        title: '登录只发生在动作那一刻',
        description:
          '游客可以逛完整个应用，包括 AI 聊天页的完整界面。点「发送」才跳登录，输入框里已经打好的字不丢。tab 页永不自动重定向——曾经这么做，返回就是白屏。',
        icon: 'tabler:login',
      },
      {
        title: 'AI 链路要「坏掉也看起来正常」',
        description:
          '模型不可用回显、Redis 不可用退内存、embedding 不可用退关键词路由、网络不可用退本地规则，四层降级。代价是排障不能只看行为，必须看日志。',
        icon: 'tabler:plug-connected',
      },
      {
        title: '跨端字段只有一处定义',
        description:
          '新增一个菜谱字段，先改 packages/types 和 schema.sql，再改实体和三端消费点。契约漂移是多端项目里最贵的一类 bug。',
        icon: 'tabler:file-text',
      },
      {
        title: '平台常量禁止凭记忆填写',
        description:
          '云托管的域名、环境 ID、镜像仓库名一律从控制台逐字复制进台账。猜出来的地址会安静地连到别处，或者根本连不上。',
        icon: 'tabler:copy',
      },
      {
        title: '先改脚本，再改代码',
        description:
          'Windows 上 <code>bash x.sh</code> 会撞上 WSL 存根。所有 shell 入口统一走 Node 包装器显式定位 Git Bash，跨平台才不是一句口号。',
        icon: 'tabler:terminal-2',
      },
      {
        title: '先把撑不住的那条线删干净',
        description:
          '这个项目最初带着一条小说业务线。确认按当时的做法它撑不住之后整块删掉，只留烹饪 Agent——半途而废的功能比没有功能更贵。后来它以「言外书斋」的形态回来了，但换了做法：设定不再塞进提示词，而是进数据库当正典。',
        icon: 'tabler:eraser',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    title="叮叮厨的数字"
    countUp
    stats={[
      { title: '客户端形态', amount: '3' },
      { title: '后端服务', amount: '2' },
      { title: '自动化测试用例', amount: '146' },
      { title: '未提交的密钥', amount: '0' },
    ]}
  />

  <!-- Timeline Widget *************** -->

  <Timeline
    id="story"
    tagline="时间线"
    title="十天，从空仓库到能下锅"
    subtitle="里程碑按开发顺序标注；提交历史压过一次，日期不是逐条 commit 的时间戳。"
    layout="alternate"
    items={[
      {
        date: '2026-09-20',
