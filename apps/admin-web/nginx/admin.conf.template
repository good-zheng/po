# 管理后台（apps/admin-web，Umi Max + Ant Design Pro SPA）线上站点：静态资源 + /api、/ws/chat 反代。
#
# 这是 .template，不是最终配置：官方 nginx 镜像的 docker-entrypoint.sh 会用 envsubst 把它渲染成
# /etc/nginx/conf.d/admin.conf。
#
# 上游主机名【不能】直接写进 proxy_pass：那样 nginx 在加载配置时就做 DNS，解析不到即
# `[emerg] host not found in upstream` + 容器退出，云托管表现为「创建版本失败」，而日志里那句 emerg
# 混在平台的 initenv.sh 报错下面很难定位。所以两个反代都走「变量 + resolver」：目标与 DNS 由
# 16-admin-upstreams.envsh 注入，解析推迟到每个请求上，上游没配或写错只让那一条路径 502，
# 改后端域名依旧是「改环境变量 + 重启」级别的事。
#
# 键名刻意带 ADMIN_ 前缀：envsubst 只替换「当前已存在的环境变量名」，用 API_UPSTREAM、HOST、PORT
# 这类短名会和平台注入的变量撞车，把 nginx 自己的运行时变量一起换掉。
# 未设置时由 16-admin-upstreams.envsh 填一个永不解析的名字（见上），镜像里不再有 api:8080 /
# chat:5090 这种只在 docker compose 网络里才解析得到的默认值。

# WebSocket 升级所需的 Connection 头映射。本文件被 include 进 http 块，所以 map 写在这里是合法的
# （写进 server 块才会报错），与 infra/nginx/nginx.conf 同一套路。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # exportStatic 会产出 /list/table-list/ 这类目录，nginx 补尾斜杠时默认发绝对重定向，
    # 会把容器内的 8080 写进 Location 从而丢掉云托管的外部端口
    absolute_redirect off;

    # 管理端的封面/素材上传走 /api/files/upload，Spring 侧 max-request-size=100MB；
    # nginx 默认 1m 会在请求体阶段直接回 413，前端只看到一个没有业务 body 的报错
    client_max_body_size 100m;

    # 云托管的公网出口按流量计费，文本资源压一下最划算
    gzip on;
    gzip_min_length 1k;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # 健康检查探针：路径固定、不查上游，后端挂了也不影响管理端静态页可用
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Spring Boot 的 server.servlet.context-path=/api 已含这个前缀，故原样透传、不 rewrite。
    # ^~ 是为了让 /api/** 下带扩展名的路径不被下面那条静态资源正则截胡。
    # 产物里的 baseURL 由 .env 决定：填了公网域名就是跨域直连，留空则落到这条同源反代。
    location ^~ /api/ {
        # 目标含变量 ⇒ nginx 不在启动时解析，由 resolver 逐次解析（10s 缓存，云托管的 pod IP 会变）
        resolver $ADMIN_API_RESOLVERS valid=10s ipv6=off;
        set $admin_api_upstream "$ADMIN_API_UPSTREAM";

        # 带变量的 proxy_pass 不做 location 前缀替换，URI 必须自己拼回去（$request_uri 连查询串一起带上）
        proxy_pass http://$admin_api_upstream$request_uri;

        # Host 发上游自己的 host:port，不把站点的宿主名转给内网入口；真实来源走 X-Forwarded-* 带上
        proxy_set_header Host $admin_api_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 聊天页与创作工作台的长连接。浏览器侧地址是 chatbot/service.ts 里用 window.location.host 拼的，
    # 永远同源，所以这条反代是管理端 WS 在生产环境唯一的通路 —— 没有对应的构建期域名变量。
    location ^~ /ws/chat {
        resolver $ADMIN_CHAT_RESOLVERS valid=10s ipv6=off;
        set $admin_chat_upstream "$ADMIN_CHAT_UPSTREAM";
        proxy_pass http://$admin_chat_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $admin_chat_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 长连接：流式回复期间不中断
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Umi hash: true 的文件名自带 contenthash，可以长缓存；=404 而不是回退 index.html，
    # 否则缺文件会变成「200 返回一份 HTML」，前端报的错会难查到离谱。
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 入口 HTML 必须不缓存：发版后旧 index.html 引用的 hash 文件已被删掉，缓存住就是白屏。
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # /list/users /novel/studio 等是 history 路由，服务端没有对应文件，全部回落到入口
    location / {
        try_files $uri $uri/ /index.html;
    }
}
