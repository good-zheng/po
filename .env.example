# ==========================================================
# po Monorepo 运行环境变量示例
# 使用方式：cp .env.example .env 后按需修改（.env 已被 .gitignore 排除）
# docker compose 会自动读取仓库根目录的 .env
# ==========================================================

# ---------- MySQL（compose 服务 mysql）----------
MYSQL_DATABASE=po
MYSQL_USER=po
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ---------- Spring Boot API ----------
# JWT 密钥：Base64 编码，解码后至少 32 字节（jjwt HMAC-SHA256 要求）
# 生成示例：printf 'your-random-secret-at-least-32-bytes!!' | base64 -w0
# 下方为仅限本地开发使用的占位密钥，生产必须替换
JWT_SECRET=cG8tbG9jYWwtZGV2LWp3dC1zZWNyZXQtY2hhbmdlLW1lLTAxMjM0NTY3ODlhYmNkZWY=
# Token 有效期（毫秒），默认 24 小时
JWT_EXPIRATION=86400000
# 是否在无超管时自动创建默认账号 superadmin/123456（生产保持 false）
APP_SEED_DEFAULT_ADMIN=false

# ---------- 网关 ----------
# Nginx 网关对外暴露端口（前端与全部 API 经由该端口同源访问）
WEB_PORT=8000

# ---------- FastAPI 聊天服务 ----------
PY_SERVER_CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ---------- 智能体编排核心（agent-core，前缀 AGENT_CORE_）----------
# LLM 走 OpenAI 兼容协议；provider 预设：qwen（DashScope）/ deepseek / openai / custom
AGENT_CORE_LLM_PROVIDER=qwen
AGENT_CORE_LLM_MODEL=qwen-plus
AGENT_CORE_LLM_API_KEY=change-me
# ---------- 多模型（可选）：按阶段角色覆盖模型 ----------
# 不配这一段就是单模型（所有调用都走上面的默认槽位），配了才分角色。
# 角色：chat=闲聊兜底 / plan=构思&大纲 / write=正文 / judge=审稿&抽取
# 同 provider 换模型：只写 MODEL，密钥与网关自动复用默认槽位
# 换 provider：必须连 API_KEY 一起给（跨家复用密钥是错配，程序直接报错而非静默回退）
# 生效时机：改完 .env 重启服务（模型在装配期取定，运行中不热切换）
#AGENT_CORE_LLM_ROLES__CHAT__MODEL=qwen-turbo
#AGENT_CORE_LLM_ROLES__WRITE__MODEL=qwen-max
#AGENT_CORE_LLM_ROLES__JUDGE__PROVIDER=deepseek
#AGENT_CORE_LLM_ROLES__JUDGE__MODEL=deepseek-chat
#AGENT_CORE_LLM_ROLES__JUDGE__API_KEY=change-me
# 温度也可分角色覆盖（长文写作偏低、评审偏高）
#AGENT_CORE_LLM_ROLES__WRITE__TEMPERATURE=0.8
# 会话状态持久化：redis / sqlite / memory（测试用 memory 保持隔离）
AGENT_CORE_CHECKPOINTER=redis
AGENT_CORE_REDIS_URL=redis://localhost:6379
# 语义路由 embedding（qwen 预设 text-embedding-v4；空 = 回退 LLM 同名配置；
# 两者都缺时意图路由降级为本地关键词匹配，垂直 Agent 仍可被路由到）
# 注意：deepseek 预设没有 embedding 接口，用 deepseek 时这三项要显式填
# 其他家的地址（如 DashScope text-embedding-v4）才能启用语义路由
AGENT_CORE_EMBEDDING_MODEL=
AGENT_CORE_EMBEDDING_API_KEY=
AGENT_CORE_EMBEDDING_BASE_URL=

# ---------- 本地开发（不经网关直连后端）----------
# 注意：前端 dev server 不读取本文件（Umi 只加载 apps/admin-web/.env，不会向上查找 monorepo 根目录）
# 后端 API / 聊天 WebSocket 地址请配置 apps/admin-web/.env，模板见 apps/admin-web/.env.example
