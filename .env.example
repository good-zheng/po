# ==========================================================
# po Monorepo 运行环境变量示例
# 使用方式：cp .env.example .env 后按需修改（.env 已被 .gitignore 排除）
# docker compose 会自动读取仓库根目录的 .env
# ==========================================================

# ---------- MySQL（compose 服务 mysql）----------
MYSQL_DATABASE=po
MYSQL_USER=po
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ---------- Spring Boot API ----------
# JWT 密钥：Base64 编码，解码后至少 32 字节（jjwt HMAC-SHA256 要求）
# 生成示例：printf 'your-random-secret-at-least-32-bytes!!' | base64 -w0
# 下方为仅限本地开发使用的占位密钥，生产必须替换
JWT_SECRET=cG8tbG9jYWwtZGV2LWp3dC1zZWNyZXQtY2hhbmdlLW1lLTAxMjM0NTY3ODlhYmNkZWY=
# Token 有效期（毫秒），默认 24 小时
JWT_EXPIRATION=86400000
# 是否在无超管时自动创建默认账号 superadmin/123456（生产保持 false）
APP_SEED_DEFAULT_ADMIN=false

# ---------- 讯飞语音合成 TTS + 语音听写 IAT（共用同一套 AppID/Key/Secret）----------
# 开放平台控制台创建应用后获取。TTS 供做菜模式播报与「言外」建议朗读；
# IAT 供「言外」实时转写。未开通听写服务时 /ws/asr 会返回可读错误并提示改用文字输入。
# vcn 为发音人，默认 xiaoyan（小燕）。
IFLYTEK_APP_ID=change-me
IFLYTEK_API_KEY=change-me
IFLYTEK_API_SECRET=change-me
IFLYTEK_TTS_VCN=xiaoyan
# 听写语种与口音；max-seconds 是单个讯飞会话时长上限（讯飞硬限制 60s）
IFLYTEK_ASR_LANGUAGE=zh_cn
IFLYTEK_ASR_ACCENT=mandarin
IFLYTEK_ASR_MAX_SECONDS=55

# ---------- 内网回调令牌（chat 服务 → Spring Boot）----------
# 一条令牌三个消费方，Python 侧前缀不同（各包自己的 Settings）：
#   agent-talk  → TALK_INTERNAL_TOKEN   （回写 /talk/internal/suggestions）
#   agent-novel → NOVEL_INTERNAL_TOKEN  （写 /novel/internal/**：成稿 + 正典）
#   chat 宿主   → PY_SERVER_INTERNAL_TOKEN（WS 握手验票 /novel/internal/chat-ticket/verify）
# 两端不一致时写入被 403 拒绝；未配置时端点一律拒绝（安全默认值）。
# 生成示例：openssl rand -hex 24
APP_INTERNAL_TOKEN=change-me

# ---------- 腾讯云 COS 对象存储（头像/上传/TTS 音频落桶）----------
# 密钥从 云托管「环境设置-密钥」或 腾讯云 CAM 子账号（需 COS 读写权限）获取。
# region/bucket 已给默认值（本项目为 ap-shanghai / 7072-prod-d7g3zal0655a67232-1496875399）；
# base-url 仅在走自定义 CDN/静态域名时填，留空用 {bucket}.cos.{region}.myqcloud.com。
COS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
COS_REGION=ap-shanghai
COS_BUCKET=7072-prod-d7g3zal0655a67232-1496875399
COS_KEY_PREFIX=po
COS_BASE_URL=

# ---------- 网关 ----------
# Nginx 网关对外暴露端口（前端与全部 API 经由该端口同源访问）
WEB_PORT=8000

# ---------- FastAPI 聊天服务 ----------
PY_SERVER_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# WS 握手票据：novel-chat 会读某本书的正典，连接必须先经 api 验票才拿到作者身份。
# chat 不加签也不持 jwt.secret——票据由 Spring Boot 签也由它验，这里只是回调通道。
# PY_SERVER_INTERNAL_TOKEN 留空 = 没有验票通道，novel-chat 一律拒连（其余插槽不受影响）。
PY_SERVER_API_BASE_URL=http://localhost:8080/api
PY_SERVER_INTERNAL_TOKEN=change-me

# ---------- 智能体编排核心（agent-core，前缀 AGENT_CORE_）----------
# LLM 走 OpenAI 兼容协议；provider 预设：qwen（DashScope）/ deepseek / openai / custom
AGENT_CORE_LLM_PROVIDER=qwen
AGENT_CORE_LLM_MODEL=qwen-plus
AGENT_CORE_LLM_API_KEY=change-me
# ---------- 多模型（可选）：按阶段角色覆盖模型 ----------
# 不配这一段就是单模型（所有调用都走上面的默认槽位），配了才分角色。
# 角色：chat=闲聊兜底 / cooking=烹饪助手 / talk=言外沟通助手
#      / plan=规划类（结构化抽取、大纲等）
#      / write=长文生成 / judge=评审判定类
# 同 provider 换模型：只写 MODEL，密钥与网关自动复用默认槽位
# 换 provider：必须连 API_KEY 一起给（跨家复用密钥是错配，程序直接报错而非静默回退）
# 生效时机：改完 .env 重启服务（模型在装配期取定，运行中不热切换）
#AGENT_CORE_LLM_ROLES__CHAT__MODEL=qwen-turbo
#AGENT_CORE_LLM_ROLES__COOKING__MODEL=qwen-plus
#AGENT_CORE_LLM_ROLES__TALK__MODEL=qwen-plus
#AGENT_CORE_LLM_ROLES__WRITE__MODEL=qwen-max
#AGENT_CORE_LLM_ROLES__JUDGE__PROVIDER=deepseek
#AGENT_CORE_LLM_ROLES__JUDGE__MODEL=deepseek-chat
#AGENT_CORE_LLM_ROLES__JUDGE__API_KEY=change-me
# 温度也可分角色覆盖（生成类偏低、评审类偏高，按角色用途自行权衡）
#AGENT_CORE_LLM_ROLES__WRITE__TEMPERATURE=0.8
# 会话状态持久化：redis / sqlite / memory（测试用 memory 保持隔离）
AGENT_CORE_CHECKPOINTER=redis
AGENT_CORE_REDIS_URL=redis://localhost:6379
# 语义路由 embedding（qwen 预设 text-embedding-v4；空 = 回退 LLM 同名配置；
# 两者都缺时意图路由降级为本地关键词匹配，垂直 Agent 仍可被路由到）
# 注意：deepseek 预设没有 embedding 接口，用 deepseek 时这三项要显式填
# 其他家的地址（如 DashScope text-embedding-v4）才能启用语义路由
AGENT_CORE_EMBEDDING_MODEL=
AGENT_CORE_EMBEDDING_API_KEY=
AGENT_CORE_EMBEDDING_BASE_URL=

# ---------- 烹饪助手插槽（agent-cooking，前缀 COOKING_）----------
# 菜谱接口根地址（含 /api 前缀）；接口是 permitAll 公开读，无需用户令牌。
# 本地开发默认指向本机 Spring Boot；容器内由 docker-compose 覆盖为 http://api:8080/api
COOKING_API_BASE_URL=http://localhost:8080/api

# ---------- 小说插槽（agent-novel，前缀 NOVEL_）----------
# 成稿与正典都经 /novel/internal/** 写库：地址含 /api 前缀，令牌必须等于 APP_INTERNAL_TOKEN，
# 两端不一致时写入被 403 拒绝（Java 侧对「未配置」与「不匹配」都拒绝）。
# NOVEL_AUTHOR_ID：内部通道建书要落到某个用户名下（book.author_id NOT NULL），
# 归档发起人进不到这条链路前先用它兜底，填本地 users 表里存在的一个 id。
# NOVEL_PERSIST_ENABLED=false 时成稿与正典都只留在进程内（本地无后端时自测用）。
NOVEL_API_BASE_URL=http://localhost:8080/api
NOVEL_INTERNAL_TOKEN=change-me
NOVEL_AUTHOR_ID=1
#NOVEL_PERSIST_ENABLED=false

# ---------- 本地开发（不经网关直连后端）----------
# 注意：前端 dev server 不读取本文件（Umi 只加载 apps/admin-web/.env，不会向上查找 monorepo 根目录）
# 后端 API / 聊天 WebSocket 地址请配置 apps/admin-web/.env，模板见 apps/admin-web/.env.example
