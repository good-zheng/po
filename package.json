{
  "name": "po",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "types:build": "pnpm --filter @po/types build",
    "admin:dev": "pnpm types:build && pnpm --filter @po/admin dev",
    "admin:build": "pnpm types:build && pnpm --filter @po/admin build",
    "admin:lint": "pnpm --filter @po/admin lint",
    "admin:test": "pnpm --filter @po/admin test",
    "admin:typecheck": "pnpm types:build && pnpm --filter @po/admin tsc",
    "api:install": "node scripts/run-service.mjs api install",
    "api:start": "node scripts/run-service.mjs api start",
    "api:verify": "node scripts/run-service.mjs api verify",
    "api:deploy": "node scripts/run-sh.mjs scripts/deploy-api.sh",
    "api:deploy:official": "node scripts/run-sh.mjs --env USE_OFFICIAL_IMAGES=1 scripts/deploy-api.sh",
    "chat:install": "node scripts/run-service.mjs chat install",
    "chat:start": "node scripts/run-service.mjs chat start",
    "chat:test": "node scripts/run-service.mjs chat test",
    "chat:deploy": "node scripts/run-sh.mjs scripts/deploy-chat.sh",
    "chat:deploy:official": "node scripts/run-sh.mjs --env USE_OFFICIAL_IMAGES=1 scripts/deploy-chat.sh",
    "redis:deploy": "node scripts/run-sh.mjs scripts/deploy-redis.sh",
    "redis:deploy:official": "node scripts/run-sh.mjs --env USE_OFFICIAL_IMAGES=1 scripts/deploy-redis.sh",
    "agentcore:test": "node scripts/run-service.mjs agentcore test",
    "agentcooking:test": "node scripts/run-service.mjs agentcooking test",
    "mobile:start": "pnpm --filter @po/cooking start",
    "mobile:android": "node scripts/run-mobile.mjs android",
    "mobile:apk": "node scripts/run-mobile.mjs apk",
    "mobile:ios": "pnpm --filter @po/cooking ios",
    "mobile:web": "pnpm --filter @po/cooking web",
    "mobile:prebuild:android": "pnpm --filter @po/cooking prebuild:android",
    "mobile:lint": "pnpm --filter @po/cooking lint",
    "mobile:typecheck": "pnpm --filter @po/cooking typecheck",
    "mobile:test": "pnpm --filter @po/cooking test",
    "mobile:eas:preview": "pnpm --dir apps/cooking-app dlx eas-cli@latest build --platform android --profile preview",
    "mobile:eas:production": "pnpm --dir apps/cooking-app dlx eas-cli@latest build --platform android --profile production",
    "mini:dev": "pnpm --filter @po/cooking-mini dev:weapp",
    "mini:build": "pnpm --filter @po/cooking-mini build:weapp",
    "mini:dev:h5": "pnpm --filter @po/cooking-mini dev:h5",
    "mini:build:h5": "pnpm --filter @po/cooking-mini build:h5",
    "brand:dev": "pnpm --filter @po/brand dev",
    "brand:build": "pnpm --filter @po/brand build",
    "brand:preview": "pnpm --filter @po/brand preview",
    "brand:check": "pnpm --filter @po/brand check",
    "brand:assets": "pnpm --filter @po/brand assets:gen",
    "brand:deploy": "node scripts/run-sh.mjs scripts/deploy-brand.sh",
    "brand:deploy:official": "node scripts/run-sh.mjs --env USE_OFFICIAL_IMAGES=1 scripts/deploy-brand.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
